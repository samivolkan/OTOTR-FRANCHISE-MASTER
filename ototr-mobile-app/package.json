{
  "name": "ototr-mobile-app",
  "version": "0.1.0",
  "private": true,
  "description": "OTOTR Terminal mobil uygulamasi PWA/Capacitor-ready altyapi.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "validate:phase0": "node scripts/validate-phase0.mjs",
    "validate:sources": "node scripts/validate-source-hashes.mjs",
    "validate:workflow": "node scripts/validate-workflow-components.mjs",
    "validate:phase1-extra": "node scripts/validate-phase1-extra-screens.mjs",
    "validate:mapping": "node scripts/validate-mobile-module-mapping.mjs",
    "validate:all": "npm run validate:phase0 && npm run validate:sources && npm run validate && npm run validate:workflow && npm run validate:phase1-extra && npm run validate:mapping",
    "validate": "node scripts/validate-phase1.mjs",
    "build": "node scripts/validate-phase1.mjs --skip-legacy-faz4",
    "config:supabase": "node scripts/write-supabase-runtime-config.mjs",
    "config:supabase:local": "node scripts/write-supabase-runtime-config.mjs",
    "config:supabase:stage": "npm run config:supabase:staging",
    "config:supabase:staging": "node -e \"process.env.OTOTR_MOBILE_SUPABASE_PROFILE='staging'; import('./scripts/write-supabase-runtime-config.mjs')\"",
    "config:supabase:production": "node -e \"process.env.OTOTR_MOBILE_SUPABASE_PROFILE='production'; import('./scripts/write-supabase-runtime-config.mjs')\"",
    "release:preflight": "node scripts/release-preflight.mjs",
    "android:prepare": "npm run config:supabase && node scripts/prepare-capacitor-web.mjs",
    "android:prepare:production": "npm run config:supabase:production && node scripts/prepare-capacitor-web.mjs",
    "android:patch-java": "node scripts/patch-capacitor-java.mjs",
    "android:sync": "npm run android:prepare && npx cap sync android && npm run android:patch-java",
    "android:sync:production": "npm run android:prepare:production && npx cap sync android && npm run android:patch-java && npm run release:preflight",
    "android:open": "npx cap open android",
    "android:build:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:build:release": "npm run android:sync:production && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "esbuild": "^0.28.1"
  }
}
