{
  "name": "ototr-franchise-master",
  "version": "1.0.0",
  "description": "This is the clean master workspace for the OTOTR Franchise System.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "check:backend-contracts": "node tools/check-backend-contracts.mjs",
    "config:dealer:supabase": "node apps/admin/prototype/tools/write-dealer-supabase-runtime-config.mjs",
    "config:dealer:supabase:local": "node apps/admin/prototype/tools/write-dealer-supabase-runtime-config.mjs",
    "config:dealer:supabase:staging": "node -e \"process.env.OTOTR_DEALER_SUPABASE_PROFILE='staging'; import('./apps/admin/prototype/tools/write-dealer-supabase-runtime-config.mjs')\"",
    "config:dealer:supabase:production": "node -e \"process.env.OTOTR_DEALER_SUPABASE_PROFILE='production'; import('./apps/admin/prototype/tools/write-dealer-supabase-runtime-config.mjs')\"",
    "config:supabase": "node tools/write-shared-supabase-runtime-configs.mjs",
    "config:supabase:local": "node tools/write-shared-supabase-runtime-configs.mjs",
    "config:supabase:staging": "node -e \"process.env.OTOTR_SHARED_SUPABASE_PROFILE='staging'; import('./tools/write-shared-supabase-runtime-configs.mjs')\"",
    "config:supabase:production": "node -e \"process.env.OTOTR_SHARED_SUPABASE_PROFILE='production'; import('./tools/write-shared-supabase-runtime-configs.mjs')\"",
    "check:supabase-readiness": "node tools/check-supabase-local-readiness.mjs",
    "smoke:evidence:storage": "node tools/local-evidence-storage-upload-smoke.mjs",
    "smoke:e2e:no-upload": "node tools/local-e2e-no-upload-acceptance-smoke.mjs",
    "smoke:first-work-order:clean": "node tools/local-first-work-order-clean-e2e.mjs",
    "test:dealer-print": "node apps/admin/prototype/tools/test-bayi-final-report-print.mjs",
    "test:public-api": "node tools/test-public-api.mjs",
    "test": "echo \"Use a scoped test script, for example: npm run test:public-api\" && exit 1",
    "ai:plan": "node scripts/ototr-orchestrator.mjs plan",
    "ai:plan:dry": "node scripts/ototr-orchestrator.mjs plan --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samivolkan/OTOTR-FRANCHISE-MASTER.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/samivolkan/OTOTR-FRANCHISE-MASTER/issues"
  },
  "homepage": "https://github.com/samivolkan/OTOTR-FRANCHISE-MASTER#readme"
}
